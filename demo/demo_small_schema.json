{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/demo-small.schema.json",
    "title": "Demo Pipeline Custom Schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "on",
        "jobs"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 3
        },
        "on": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "push",
                "workflow_dispatch"
            ],
            "properties": {
                "push": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "branches"
                    ],
                    "properties": {
                        "branches": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "workflow_dispatch": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "inputs": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "deploy_env": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "required",
                                        "default",
                                        "type",
                                        "options"
                                    ],
                                    "properties": {
                                        "description": {
                                            "type": "string"
                                        },
                                        "required": {
                                            "type": "boolean"
                                        },
                                        "default": {
                                            "type": "string"
                                        },
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "choice"
                                            ]
                                        },
                                        "options": {
                                            "type": "array",
                                            "minItems": 1,
                                            "uniqueItems": true,
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "env": {
            "type": "object",
            "additionalProperties": {
                "type": "string",
                "minLength": 1
            }
        },
        "jobs": {
            "type": "object",
            "patternProperties": {
                "^[a-z][a-z0-9_-]*$": {
                    "$ref": "#/definitions/job"
                }
            },
            "additionalProperties": false,
            "required": [
                "lint",
                "test",
                "deploy"
            ]
        }
    },
    "definitions": {
        "job": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "runs-on",
                "steps"
            ],
            "properties": {
                "runs-on": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        }
                    ]
                },
                "needs": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1,
                            "uniqueItems": true
                        }
                    ]
                },
                "if": {
                    "type": "string"
                },
                "timeout-minutes": {
                    "type": "integer",
                    "minimum": 1
                },
                "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/step"
                    }
                }
            }
        },
        "step": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9 _().:-]+$"
                },
                "uses": {
                    "type": "string",
                    "pattern": "^[^@]+@[^@]+$"
                },
                "run": {
                    "type": "string",
                    "minLength": 1
                },
                "shell": {
                    "type": "string",
                    "enum": [
                        "bash",
                        "sh",
                        "pwsh",
                        "python"
                    ]
                },
                "with": {
                    "type": "object",
                    "propertyNames": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                    },
                    "additionalProperties": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "number"
                            },
                            {
                                "type": "boolean"
                            }
                        ]
                    }
                }
            },
            "anyOf": [
                {
                    "required": [
                        "uses"
                    ]
                },
                {
                    "required": [
                        "run"
                    ]
                }
            ]
        }
    }
}