{
  "name": "my-pipeline",
  "jobs": {
    "lint": {
      "runs-on": "ubuntu-latest",
      "steps": [
        {"name": "Run linter", "run": "flake8 ."}
      ]
    },
    "test": {
      "runs-on": "ubuntu-latest",
      "needs": "lint",
      "steps": [
        {"name": "Run tests", "run": "pytest"},
        {"name": "Upload coverage", "run": "codecov"}
      ]
    },
    "deploy": {
      "runs-on": "ubuntu-latest",
      "needs": "test",
      "steps": [
        {"name": "Deploy to staging", "run": "./deploy.sh staging"}
      ]
    }
  }
}